          "uid": "pytweezer"
        },
        "query": "SELECT rid AS __value, rid || ' ' || coalesce(class_name, '') || coalesce(' (' || nullif(label, '') || ')', '') AS __text FROM runs ORDER BY rid DESC LIMIT 500",
        "definition": "SELECT rid AS __value, rid || ' ' || coalesce(class_name, '') || coalesce(' (' || nullif(label, '') || ')', '') AS __text FROM runs ORDER BY rid DESC LIMIT 500",
