          "uid": "pytweezer"
        },
        "query": "SELECT DISTINCT field FROM readings WHERE $__timeFilter(time) AND measurement = '$measurement'",
        "definition": "SELECT DISTINCT field FROM readings WHERE $__timeFilter(time) AND measurement = '$measurement'",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
