        },
        "query": "SELECT DISTINCT key FROM points, jsonb_each(scalars) WHERE rid = $rid AND jsonb_typeof(value) = 'number'",
        "definition": "SELECT DISTINCT key FROM points, jsonb_each(scalars) WHERE rid = $rid AND jsonb_typeof(value) = 'number'",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "current": {},
        "options": [],
