        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "pytweezer"
        },
        "query": "SELECT DISTINCT key FROM points, jsonb_each(scan_values) WHERE rid = $rid AND jsonb_typeof(value) = 'number'",
        "definition": "SELECT DISTINCT key FROM points, jsonb_each(scan_values) WHERE rid = $rid AND jsonb_typeof(value) = 'number'",
